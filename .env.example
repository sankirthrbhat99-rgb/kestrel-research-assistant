# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# LLM credentials — pick ONE provider; the others can be left blank.
# ---------------------------------------------------------------------------

# Provider 1: Explicit KESTREL override (highest priority).
# Works with any OpenAI-compatible endpoint (OpenAI, vLLM, Together, etc.).
KESTREL_LLM_API_KEY=
KESTREL_LLM_BASE_URL=https://api.openai.com/v1
KESTREL_LLM_MODEL=gpt-4o-mini
KESTREL_LLM_TIMEOUT=60

# Provider 2: Groq — auto-detected; sets endpoint + llama-3.3-70b-versatile.
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=

# Provider 3: Gemini — auto-detected; sets Google OpenAI-compat endpoint + gemini-2.0-flash.
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Provider 4: OpenAI
OPENAI_API_KEY=

# Provider 5: DeepSeek
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Corpus / ingestion
# ---------------------------------------------------------------------------
# Override if the corpus lives elsewhere.
#KESTREL_CORPUS_PATH=./corpus.jsonl
# Expected SHA-256 of corpus.jsonl. A mismatch emits a warning, not an error.
#KESTREL_CORPUS_SHA256=b401a4f906446f4e93f1d58c714918acf40d94d81a80c6358e5b7edd46cbbb41

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
#KESTREL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# dense | bm25 | hybrid   (dense is the Phase 1 baseline)
KESTREL_STRATEGY=dense

# ---------------------------------------------------------------------------
# LangSmith observability (optional)
# ---------------------------------------------------------------------------
# Set LANGCHAIN_TRACING_V2=true AND provide an API key to enable tracing.
# All graph runs, retrieval spans, and LLM calls will appear in LangSmith.
# Get your key at https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
# Name of the project in the LangSmith UI.
LANGCHAIN_PROJECT=kestrel-research-assistant
# Optional: point to a self-hosted LangSmith instance.
#LANGCHAIN_ENDPOINT=https://api.smith.langchain.com